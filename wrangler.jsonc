{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rmmbr",
  "main": "dist/worker.js",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js"]
    }
  ],
  "build": {
    "command": "deno run -A scripts/buildWorker.ts"
  },
  "routes": [
    {
      "pattern": "rmmbr.net",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
